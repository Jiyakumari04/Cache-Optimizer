NODE_ENV=production
PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The exact address people open in the browser, no trailing slash.
# Free Render example: https://your-app-name.onrender.com
# Own domain example: https://yourdomain.com
CLIENT_ORIGIN=https://your-app-name.onrender.com
# Leave unset on your computer. Set to 0.0.0.0 on Render or similar hosts.
# HOST=0.0.0.0
# The account registered with this email becomes admin
ADMIN_EMAIL=
DB_FILE=./data/app.db